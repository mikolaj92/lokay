#!/bin/sh
check_command() {
    check_arguments "$@"
    restricted=$?
    [ "$restricted" -ne 2 ] || return 1
    [ "$restricted" -ne 0 ] || return 0
    [ -n "${LOKAY_PI_GITDIR-}" ] || return 1
    total=$#
    count=$global_count
    for option do
        [ "$count" -gt 0 ] || break
        set -- "$@" "$option"
        count=$((count - 1))
    done
    while [ "$total" -gt 0 ]; do
        shift
        total=$((total - 1))
    done
    target=$(/usr/bin/git "$@" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 0
    target=$(CDPATH= cd -- "$target" && pwd -P) || return 0
    [ "$target" != "$LOKAY_PI_GITDIR" ]
}
check_arguments() {
    original_count=$#
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -C|--git-dir|--work-tree|--namespace|-c) [ "$#" -ge 2 ] || return 2; shift 2 ;;
            --git-dir=*|--work-tree=*|--namespace=*) shift ;;
            --no-pager|--paginate|--literal-pathspecs|--no-optional-locks) shift ;;
            --version) [ "$original_count" -eq 1 ] && return 0; return 2 ;;
            -*) return 2 ;;
            *) break ;;
        esac
    done
    global_count=$((original_count - $#))
    command=${1-}
    [ "$#" -eq 0 ] || shift
    case "$command" in
        commit|push|reset|rebase|merge|tag|update-ref|cherry-pick|am|stash|pull|fetch|remote|config|switch|symbolic-ref|worktree|notes|replace) return 1 ;;
        branch) [ "$#" -eq 0 ] || return 1 ;;
        checkout)
            case "${1-}" in
                --) [ "$#" -ge 2 ] ;;
                -*) return 1 ;;
                *) [ "$#" -ge 3 ] && [ "$2" = "--" ] ;;
            esac ;;
    esac
}
if ! check_command "$@"; then
    printf '%s\n' 'git: command blocked for pi' >&2
    exit 1
fi
exec /usr/bin/git "$@"
