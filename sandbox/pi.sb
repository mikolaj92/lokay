(version 1)
(allow default)
(deny file-read*
    (subpath (string-append (param "HOME") "/Desktop"))
    (subpath (string-append (param "HOME") "/Documents"))
    (subpath (string-append (param "HOME") "/Downloads"))
    (subpath (string-append (param "HOME") "/Movies"))
    (subpath (string-append (param "HOME") "/Music"))
    (subpath (string-append (param "HOME") "/Pictures"))
    (subpath (string-append (param "HOME") "/.Trash"))
    (subpath (string-append (param "HOME") "/Library")))
(deny file-write*)
(allow file-write*
    (subpath (param "WORKTREE"))
    (subpath (param "ARTIFACT_DIR"))
    (subpath (param "GITDIR"))
    (subpath (param "TMPDIR"))
    (subpath "/private/tmp")
    (subpath "/private/var/folders")
    (subpath "/dev")
    (subpath (string-append (param "HOME") "/.pi"))
    (subpath (string-append (param "HOME") "/.cache"))
    (subpath (string-append (param "HOME") "/.local/share/uv"))
    (subpath (string-append (param "HOME") "/.local/share/mise"))
    (subpath (string-append (param "HOME") "/.local/state"))
    (subpath (string-append (param "HOME") "/.npm"))
    (subpath (string-append (param "HOME") "/.config/uv")))
