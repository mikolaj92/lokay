      "parameters": {"type": "object", "properties": {"search_text": {"type": "string"}, "file_patterns": {"type": "array", "items": {"type": "string"}}, "case_sensitive": {"type": "boolean"}, "use_perl_regexp": {"type": "boolean"}}, "required": ["search_text"]}
    }
  }
